# Sea Chef Labs execution API configuration
# NEVER commit real values. Store credentials in the deployment/exchange secret store.
SCL_EXECUTION_ENABLED=false
SCL_EXCHANGE=okx
SCL_EXCHANGE_API_KEY=
SCL_EXCHANGE_API_SECRET=
SCL_EXCHANGE_API_PASSPHRASE=
# Optional hard safety caps enforced server-side when execution is later implemented.
SCL_MAX_ORDER_AUD=0
SCL_MAX_DAILY_AUD=0

# OKX Australia: AU accounts use the regional API domain documented by OKX.
SCL_OKX_BASE_URL=https://us.okx.com
# Keep demo true until demo API tests pass.
SCL_OKX_DEMO=true

# Demo service limits (USDT, not AUD).
SCL_DEMO_MAX_ORDER_USDT=100
SCL_DEMO_MAX_DAILY_USDT=300
SCL_DEMO_PORT=8787
